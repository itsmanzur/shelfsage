{
  "name": "shelfsage",
  "version": "1.5.0",
  "description": "ShelfSage — Book management plugin for WooCommerce",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "strip-bom": "node -e \"const fs=require('fs'),path=require('path'),g=d=>{fs.readdirSync(d,{withFileTypes:true}).forEach(e=>{const fp=path.join(d,e.name);if(e.isDirectory()){if(e.name==='node_modules')return;g(fp);}else if(fp.endsWith('.php')){const b=fs.readFileSync(fp);if(b[0]===0xEF&&b[1]===0xBB&&b[2]===0xBF){fs.writeFileSync(fp,b.slice(3));console.log('BOM stripped:',fp.replace(process.cwd(),''));}}})};g('.');\"",
    "build": "vite build && npm run strip-bom",
    "watch": "vite build --watch",
    "build:blocks": "wp-scripts build",
    "start:blocks": "wp-scripts start",
    "release": "npm run build && node scripts/release.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "lodash.debounce": "^4.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-masonry-css": "^1.0.16",
    "swiper": "^12.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@wordpress/scripts": "^31.5.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^5.2.11"
  }
}
